<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_md_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lyrics"
            android:tint="@color/md_widget_primary" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_widget_subtle"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_md_button_primary"
            android:contentDescription="@string/widget_play_pause"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play"
            android:tint="@color/md_widget_on_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_lyrics_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_lyric_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.55"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_widget_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_lyric_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/md_widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_lyric_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.55"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
