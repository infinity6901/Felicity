<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        This widget has no separate small album-art thumbnail — the blurred background
        IS the art. MinimalWidgetProvider overrides loadAlbumArt() to skip that fetch
        entirely rather than loading a thumbnail that would never be shown.
    -->
    <ImageView
        android:id="@+id/widget_background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@null"
        android:scaleType="centerInside"
        android:src="@drawable/ic_play" />

</FrameLayout>
