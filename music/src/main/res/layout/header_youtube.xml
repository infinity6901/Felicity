<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/padding_10">

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_15"
        android:layout_marginTop="@dimen/padding_15"
        android:text="@string/youtube_panel"
        android:textSize="@dimen/text_size_18"
        app:appFontStyle="bold"
        app:textColorStyle="primary" />

    <app.simple.felicity.decorations.corners.DynamicCornerEditText
        android:id="@+id/youtube_search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_15"
        android:hint="@string/youtube_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="@dimen/padding_15"
        android:paddingVertical="@dimen/padding_10"
        android:singleLine="true"
        android:textSize="@dimen/text_size_14" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_10">

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/tab_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/youtube_tab_home"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/tab_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/youtube_tab_search"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/tab_playlists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/youtube_tab_library"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/tab_downloaded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="Downloaded Only"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/import_playlist_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="Import Link"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/youtube_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/youtube_sign_in"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

    </LinearLayout>

    <app.simple.felicity.decorations.highlight.HighlightTextView
        android:id="@+id/playlist_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_15"
        android:layout_marginTop="@dimen/padding_5"
        android:paddingVertical="@dimen/padding_5"
        android:paddingHorizontal="@dimen/padding_10"
        android:text="@string/youtube_back_to_playlists"
        android:textSize="@dimen/text_size_14"
        android:visibility="gone"
        app:appFontStyle="bold"
        app:highlightMode="auto"
        app:textColorStyle="primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/download_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_15"
            android:layout_marginTop="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/youtube_download_all"
            android:textSize="@dimen/text_size_14"
            android:visibility="gone"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/cancel_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:layout_marginTop="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/cancel_download"
            android:textSize="@dimen/text_size_14"
            android:visibility="gone"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_10"
        android:layout_marginTop="@dimen/padding_5"
        android:visibility="gone">

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/select_all"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/download_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_10"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/download_selected"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/cancel_selection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/cancel"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

    </LinearLayout>

</LinearLayout>
