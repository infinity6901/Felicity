<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/padding_15"
    android:paddingBottom="@dimen/padding_10">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/padding_10"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_10"
        android:gravity="center"
        android:textSize="@dimen/text_size_18"
        app:appFontStyle="black"
        app:textColorStyle="primary" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/text_size_14"
        app:appFontStyle="medium"
        app:textColorStyle="secondary" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_10"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/action_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_15"
                android:paddingVertical="@dimen/padding_5"
                android:text="@string/youtube_play"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:highlightMode="auto"
                app:textColorStyle="primary" />

            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/action_shuffle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_15"
                android:paddingVertical="@dimen/padding_5"
                android:text="@string/youtube_shuffle"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:highlightMode="auto"
                app:textColorStyle="primary" />

            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/action_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_15"
                android:paddingVertical="@dimen/padding_5"
                android:text="@string/youtube_radio"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:highlightMode="auto"
                app:textColorStyle="primary" />

            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/action_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_15"
                android:paddingVertical="@dimen/padding_5"
                android:text="@string/youtube_subscribe"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:highlightMode="auto"
                app:textColorStyle="primary" />

        </LinearLayout>
    </HorizontalScrollView>

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_10"
        android:ellipsize="end"
        android:maxLines="4"
        android:textSize="@dimen/desc_text_size"
        app:appFontStyle="regular"
        app:textColorStyle="secondary" />

</LinearLayout>
