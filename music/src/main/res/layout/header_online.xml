<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:animateLayoutChanges="true"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_15"
        android:animateLayoutChanges="true"
        android:orientation="horizontal">

        <app.simple.felicity.decorations.corners.DynamicCornerEditText
            android:id="@+id/edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="@dimen/padding_10"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/padding_5"
            android:hint="@string/online_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="yes"
            android:inputType="text"
            android:maxLines="1"
            app:appFontStyle="bold"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.views.Loader
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_5"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_5"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:paddingHorizontal="@dimen/padding_10"
        android:orientation="horizontal">

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/source_radio_browser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/online_source_radio_browser"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/source_jamendo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/online_source_jamendo"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/source_audius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/online_source_audius"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/source_internet_archive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/online_source_internet_archive"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/source_youtube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_5"
            android:paddingVertical="@dimen/padding_5"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/online_source_youtube"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="primary" />

    </LinearLayout>

    </HorizontalScrollView>

    <app.simple.felicity.decorations.highlight.HighlightTextView
        android:id="@+id/youtube_sign_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_15"
        android:layout_marginTop="@dimen/padding_5"
        android:paddingVertical="@dimen/padding_5"
        android:paddingHorizontal="@dimen/padding_10"
        android:text="@string/youtube_sign_in"
        android:textSize="@dimen/text_size_14"
        android:visibility="gone"
        app:appFontStyle="bold"
        app:highlightMode="auto"
        app:textColorStyle="primary" />

    <app.simple.felicity.decorations.theme.ThemeDivider
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/padding_10"
        android:layout_height="1px" />

</LinearLayout>
