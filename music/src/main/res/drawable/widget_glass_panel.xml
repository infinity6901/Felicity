    <gradient
        android:angle="315"
        android:endColor="#14FFFFFF"
        android:startColor="#3DFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
    <corners android:radius="28dp" />
</shape>
