<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".application.FelicityApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Felicity"
        tools:targetApi="tiramisu">

        <!-- Lets any Activity's SearchView (or a suggestion tap routed generically) fall
             back to MainActivity as the app's searchable target if it doesn't declare its
             own android.app.searchable meta-data. -->
        <meta-data
            android:name="android.app.default_searchable"
            android:value=".activities.MainActivity" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />

            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name=".activities.CrashReporterActivity"
            android:exported="false" />

        <activity
            android:name=".activities.youtube.YoutubeLoginActivity"
            android:exported="false" />

        <service
            android:name=".repository.services.AudioDatabaseService"
            android:exported="false" />

        <service
            android:name=".server.ServerModeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Material You lyrics widget (4×2) — follows the current lyric line, see LyricsWidgetProvider. -->
        <receiver
            android:name=".widget.LyricsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lyrics_info" />
        </receiver>

        <!-- Material You 4×2 player card — see MaterialYouPlayerWidgetProvider. -->
        <receiver
            android:name=".widget.MaterialYouPlayerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_md_player_info" />
        </receiver>

        <!-- Glass 4×2 player card — see GlassPlayerWidgetProvider. -->
        <receiver
            android:name=".widget.GlassPlayerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glass_player_info" />
        </receiver>

        <!-- Glass 4×2 lyrics widget — see GlassLyricsWidgetProvider. -->
        <receiver
            android:name=".widget.GlassLyricsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glass_lyrics_info" />
        </receiver>

        <!-- Glass 2×2 art card — see GlassCardWidgetProvider. -->
        <receiver
            android:name=".widget.GlassCardWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glass_card_info" />
        </receiver>

        <!-- Material You 3×1 pill — see MaterialYouPillWidgetProvider. -->
        <receiver
            android:name=".widget.MaterialYouPillWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_md_pill_info" />
        </receiver>

        <!-- Material You 4×3 "Up next" queue widget — see UpNextWidgetProvider. -->
        <receiver
            android:name=".widget.UpNextWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_up_next_info" />
        </receiver>

        <!-- Glass 4×1 now-playing bar — see GlassBarWidgetProvider. -->
        <receiver
            android:name=".widget.GlassBarWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glass_bar_info" />
        </receiver>

        <!-- Glass 4×3 "Up next" queue widget — see GlassUpNextWidgetProvider. -->
        <receiver
            android:name=".widget.GlassUpNextWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glass_up_next_info" />
        </receiver>

        <!-- Vinyl 2×2 record widget — see VinylWidgetProvider. -->
        <receiver
            android:name=".widget.VinylWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vinyl_info" />
        </receiver>

        <!-- Handles the actual button taps (play/pause, next, prev) from the widget. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.simple.felicity.ACTION_WIDGET_PLAY_PAUSE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_NEXT" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_PREV" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- Serves suggestion rows for res/xml/searchable.xml as the user types into a
             system search surface. Exported and unprotected by a custom permission —
             SearchManager suggestion providers must be reachable by the system search UI /
             Assistant process, which is not the app's own process, and the provider itself
             only ever returns read-only, already-on-device song metadata (see
             FelicitySearchProvider's kdoc for why insert/update/delete are all no-ops). -->
        <provider
            android:name=".search.FelicitySearchProvider"
            android:authorities="${applicationId}.searchsuggest"
            android:exported="true" />

    </application>

</manifest>
